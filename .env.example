# rules：不调用模型。llm：调用 DeepSeek 兼容接口。
SP_MODE=rules
# 仅显式 true 允许 SP_MODE=llm 时从本地 Web 发起分析；默认关闭。
SP_REAL_LLM_WEB_AUTHORIZED=false
# off：模型失败时返回明确错误。rules：超时、HTTP 失败、输出校验失败时改走规则模式。
# 未配置 DEEPSEEK_API_KEY 时不会降级。
SP_LLM_FALLBACK=off
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SP_LLM_TIMEOUT_SECONDS=30
SP_DB_PATH=data/servicepilot.db
# 每百万 token 的单价。留空时评估把 LLM 费用标为未知，不会当成 0。
SP_LLM_PRICE_CURRENCY=CNY
SP_LLM_INPUT_PRICE_PER_MILLION=
SP_LLM_OUTPUT_PRICE_PER_MILLION=
